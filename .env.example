# start.cmd makes .env from this file on the first run, with its own random passwords. Never commit .env.

# ---------- The site ----------
APP_NAME=Deminic
ALLOWED_HOSTS=127.0.0.1,localhost
# How to reach the owner: shown across the site and on the terms page. Kept here, not in the code, because the code is public
CONTACT_EMAIL=you@example.com
# The owner's WhatsApp number with its country code, e.g. +1 415 555 0123. Left empty, the terms page shows the email only
OWNER_NUMBER=
PUBLIC_URL=http://127.0.0.1:8000
# The port the app listens on (change PUBLIC_URL with it)
PORT=8000
RATE_LIMIT=60/minute
MAX_UPLOAD_MB=25
SESSION_TTL=86400
IP_BLOCKLIST_FILE=blocked_ips.txt
OBFUSCATE_ASSETS=1

# ---------- Keys ----------
# Set a long random value and keep it. Changing it makes saved bank and ID numbers unreadable and hides saved pictures.
# If it's left empty, a new one is made at every start.
SECRET_KEY=change-me-to-a-long-random-value
ASSET_SALT=

# ---------- Services (setup_services.ps1 starts these in Docker) ----------
REDIS_URL=redis://127.0.0.1:6379/0
# Redis's password: long and random. setup_services.ps1 starts Redis with it, the app logs in with it
REDIS_PASSWORD=change-me-to-a-long-random-value
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=myapp
# Superuser: only used at startup to create tables and the app's own login
POSTGRES_USER=myapp
POSTGRES_PASSWORD=change-me
# What the app runs as: it can only read and write rows
POSTGRES_APP_USER=myapp_app
POSTGRES_APP_PASSWORD=change-me-too
# e.g. require, when the database isn't on this machine
POSTGRES_SSL=

# ---------- Admin console (both set, or it's off) ----------
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------- Email and SMS (left as they are, codes are printed in the server's log) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# console or twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# e.g. IN or US: lets people type phone numbers without the country code
DEFAULT_PHONE_REGION=

# ---------- Maps (company creation needs a key from geoapify.com) ----------
GEOAPIFY_API_KEY=
GEOAPIFY_SERVER_KEY=

# ---------- Payroll ----------
# Salaries are paid every this many days from the day someone joins (1 to 92)
CYCLE_DAYS=30

# ---------- Companies ----------
# How many companies one account can own at a time. Deleting one or handing it over frees a slot
MAX_COMPANIES_PER_ACCOUNT=10
# An owner not online this many days in a row: their companies halt until they're back
OWNER_AWAY_DAYS=7
# A request to join or leave that nobody answers in this many days is declined by the system
REQUEST_WINDOW_DAYS=30

# ---------- Keys ----------
# The easy way: paste them in the admin console, which tries each one first and saves it here. Keys pasted there work at once;
# anything else you change in this file needs a restart.

# ---------- Bank and ID checks ----------
# Bank checks through Cashfree (1 = on, paid per check)
BANK_VERIFY=0
# Where the ID checker's switch starts (1 = on). Once the admin console's switch is used, it decides
ID_VERIFY=0
# People's IDs, 220+ countries: a key and a workflow id from didit.me. About 30 full checks a month are free, then it stops and charges nothing
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# UK company numbers: a free key from developer.company-information.service.gov.uk. EU VIES and GLEIF need no key
COMPANIES_HOUSE_KEY=
# PAN, Indian driving licences and voter IDs by number, and bank checks: paid per check
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# ---------- Shop ----------
# Where the payments switch starts. Once the admin console's switch is used, it decides:
# off (no orders at all), cod (cash on delivery only), test (no money moves) or cashfree (real money, needs the keys below)
PAYMENTS=test
SHOP_COMMISSION_PERCENT=5
# Usernames, comma separated, who see the platform's earnings and record settlements. Sign the account up first:
# a name listed here is reserved, so nobody else can sign up with it or rename to it
PLATFORM_ADMINS=
CASHFREE_PG_CLIENT_ID=
CASHFREE_PG_CLIENT_SECRET=
CASHFREE_PG_ENV=sandbox

# ---------- The AI (optional: without it the AI's buttons are turned off) ----------
# Where the AI's switch starts: local (vLLM on your graphics card) or online (Claude, paid per use by your key). Once the admin console's switch is used, it decides
AI_MODE=local
ANTHROPIC_API_KEY=
# claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# Where Claude's monthly limit starts, in US dollars. Past it the AI goes offline until next month. The admin console can change it
CLAUDE_MONTHLY_LIMIT_USD=20
# AI work someone is waiting for stops once they've had no tab open for this many seconds. It still counts towards their limits
AI_OFFLINE_GRACE_S=15
VLLM_URL=http://127.0.0.1:8100
VLLM_MODEL=gemma-3-12b
# amd, nvidia or none (no local AI). The first run sets it from the card it finds
VLLM_GPU=amd
VLLM_PARALLEL=8
VLLM_MAX_LEN=5120

# ---------- Optional helpers on their usual addresses ----------
# TRANSLATOR_URL=http://127.0.0.1:5000
# WHISPER_URL=http://127.0.0.1:9100
